<launch>
  <include file="$(find scout_dwa)/launch/synthetic_pipeline.launch">
    <arg name="publish_synthetic_inputs" value="false"/>
    <arg name="use_footprint" value="false"/>
  </include>
  <param name="/cmd_vel_guard/require_rotation_coverage" value="true"/>
  <param name="/cmd_vel_guard/rotation_coverage_confirmed" value="true"/>
  <test test-name="planner_circle" pkg="scout_dwa" type="test_planner_lifecycle.py" time-limit="30">
    <param name="circle" value="true"/>
  </test>
</launch>
