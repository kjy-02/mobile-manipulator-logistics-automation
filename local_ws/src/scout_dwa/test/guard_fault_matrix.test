<launch>
  <node pkg="scout_dwa" type="cmd_vel_guard" name="cmd_vel_guard">
    <param name="enabled" value="true"/>
    <param name="require_config_health" value="true"/>
    <param name="require_footprint" value="true"/>
    <param name="require_rotation_coverage" value="true"/>
    <param name="rotation_coverage_confirmed" value="true"/>
    <param name="footprint_padding" value="0.05"/>
    <param name="raw_timeout" value="0.2"/>
    <param name="odom_timeout" value="0.2"/>
    <param name="obstacle_timeout" value="0.2"/>
    <param name="health_timeout" value="0.2"/>
    <param name="tf_timeout" value="0.2"/>
  </node>
  <test test-name="guard_fault_matrix" pkg="scout_dwa" type="test_guard_fault_matrix.py" time-limit="70"/>
</launch>
