<launch>
  <node pkg="scout_dwa" type="localization_monitor.py" name="localization_monitor">
    <param name="max_matching_error" value="1.0"/>
    <param name="min_inlier_fraction" value="0.5"/>
    <param name="require_pose_jump_check" value="true"/>
    <param name="max_correction_translation" value="0.2"/>
    <param name="max_correction_rotation" value="0.2"/>
  </node>
  <test test-name="localization_jump" pkg="scout_dwa" type="test_localization_jump.py" time-limit="20"/>
</launch>
