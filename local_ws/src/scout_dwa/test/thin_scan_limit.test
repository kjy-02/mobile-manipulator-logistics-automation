<launch>
  <include file="$(find scout_dwa)/launch/synthetic_pipeline.launch">
    <arg name="publish_synthetic_inputs" value="false"/>
    <arg name="obstacle_mode" value="scan"/>
  </include>
  <param name="/cmd_vel_guard/require_footprint" value="true"/>
  <test test-name="thin_scan_limit" pkg="scout_dwa" type="test_thin_scan_limit.py" time-limit="25"/>
</launch>
