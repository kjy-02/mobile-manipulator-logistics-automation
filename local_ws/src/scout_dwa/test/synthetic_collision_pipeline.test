<launch>
  <include file="$(find scout_dwa)/launch/synthetic_pipeline.launch">
    <arg name="obstacle_mode" value="map" />
    <arg name="obstacle_x" value="0.1" />
    <arg name="obstacle_y" value="0.0" />
    <arg name="use_path_cost" value="true" />
  </include>
  <test test-name="synthetic_collision_pipeline" pkg="scout_dwa"
        type="test_synthetic_pipeline.py" time-limit="40">
    <param name="obstacle_mode" value="map" />
    <param name="expected_x" value="0.1" />
    <param name="expected_y" value="0.0" />
    <param name="expect_motion" value="false" />
  </test>
</launch>
