<launch>
  <node pkg="scout_dwa" type="cmd_vel_guard" name="cmd_vel_guard" output="screen">
    <param name="enabled" value="true" />
    <param name="obstacle_mode" value="map" />
    <param name="health_timeout" value="0.4" />
    <param name="raw_timeout" value="0.4" />
    <param name="odom_timeout" value="0.4" />
    <param name="obstacle_timeout" value="0.4" />
    <param name="tf_timeout" value="0.4" />
  </node>
  <test test-name="health_guard" pkg="scout_dwa" type="test_health_guard.py" time-limit="20" />
</launch>
