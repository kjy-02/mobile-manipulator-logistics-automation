<launch>
  <node pkg="scout_dwa" type="cloud_obstacle_adapter" name="cloud_obstacle_adapter">
    <param name="input_topic" value="/scout_dwa/test_points"/>
    <param name="coverage_confirmed" value="true"/>
  </node>
  <node pkg="scout_dwa" type="static_footprint_publisher" name="static_footprint_publisher">
    <rosparam command="load" file="$(find scout_dwa)/config/synthetic_footprint.yaml"/>
  </node>
  <node pkg="dwa_planner" type="dwa_planner" name="planner_off" ns="test" output="log">
    <rosparam command="load" file="$(find scout_dwa)/config/synthetic_dwa.yaml"/>
    <param name="HZ" value="10.0"/><param name="GLOBAL_FRAME" value="map"/>
    <param name="USE_PATH_COST" value="false"/>
    <param name="USE_FOOTPRINT" value="true"/><param name="USE_SCAN_AS_INPUT" value="false"/>
    <param name="PATH_COST_GAIN" value="20.0"/>
    <param name="OBSTACLE_COST_GAIN" value="0.1"/>
    <remap from="/cmd_vel" to="/test/raw_off"/>
    <remap from="/local_map" to="/scout_dwa/local_map"/>
    <remap from="/odom" to="/scout/odom"/>
    <remap from="/footprint" to="/scout_dwa/footprint"/>
    <remap from="/path" to="/test/path"/>
  </node>
  <node pkg="dwa_planner" type="dwa_planner" name="planner_on" ns="test" output="log">
    <rosparam command="load" file="$(find scout_dwa)/config/synthetic_dwa.yaml"/>
    <param name="HZ" value="10.0"/><param name="GLOBAL_FRAME" value="map"/>
    <param name="USE_PATH_COST" value="true"/>
    <param name="USE_FOOTPRINT" value="true"/><param name="USE_SCAN_AS_INPUT" value="false"/>
    <param name="PATH_COST_GAIN" value="20.0"/>
    <param name="OBSTACLE_COST_GAIN" value="0.1"/>
    <remap from="/cmd_vel" to="/test/raw_on"/>
    <remap from="/local_map" to="/scout_dwa/local_map"/>
    <remap from="/odom" to="/scout/odom"/>
    <remap from="/footprint" to="/scout_dwa/footprint"/>
    <remap from="/path" to="/test/path"/>
  </node>
  <test test-name="path_cost_selection" pkg="scout_dwa" type="test_path_cost_selection.py" time-limit="25"/>
</launch>
