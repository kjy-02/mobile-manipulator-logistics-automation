<?xml version="1.0"?>
<launch>
  <arg name="port_name" default="can0" />
  <arg name="is_scout_mini" doc="Required: true only for Scout Mini" />
  <arg name="is_scout_omni" doc="Required: true only for Scout Omni" />
  <arg name="pub_tf" default="true" />

  <include file="$(find scout_base)/launch/scout_base.launch">
    <arg name="port_name" value="$(arg port_name)" />
    <arg name="is_scout_mini" value="$(arg is_scout_mini)" />
    <arg name="is_scout_omni" value="$(arg is_scout_omni)" />
    <arg name="simulated_robot" value="false" />
    <arg name="odom_topic_name" value="/scout/odom" />
    <arg name="pub_tf" value="$(arg pub_tf)" />
  </include>
</launch>
