<?xml version="1.0"?>
<launch>
  <!-- Minimal environment bridge. Run the pinned repository's own launch. -->
  <arg name="pointcloud_topic" default="/velodyne_points"/>
  <arg name="odom_topic" default="/scout/odom"/>
  <arg name="goal_topic" default="/move_base_simple/goal"/>
  <arg name="global_frame" default="map"/>
  <arg name="robot_frame" default="base_link"/>
  <arg name="obstacle_mode" default="map"/>
  <arg name="dwa_config" default="$(find scout_dwa)/config/dwa_scout_reference.yaml"/>
  <arg name="adapter_config" default="$(find scout_dwa)/config/cloud_adapter_reference.yaml"/>
  <arg name="footprint_config" default="$(find scout_dwa)/config/footprint_scout_v2_reference.yaml"/>
  <arg name="enable_motion_output" default="false"/>
  <arg name="hardware_verified" default="false"/>
  <arg name="coverage_confirmed" default="false"/>
  <arg name="rotation_coverage_confirmed" default="false"/>
  <arg name="guarded_cmd_topic" default="/scout_dwa/cmd_vel_safe"/>

  <node pkg="scout_dwa" type="cloud_obstacle_adapter" name="cloud_obstacle_adapter" output="screen">
    <rosparam command="load" file="$(arg adapter_config)"/>
    <param name="input_topic" value="$(arg pointcloud_topic)"/>
    <param name="target_frame" value="$(arg robot_frame)"/>
    <param name="coverage_confirmed" value="$(arg coverage_confirmed)"/>
    <param name="publish_map" value="$(eval arg('obstacle_mode') == 'map')"/>
    <param name="publish_scan" value="$(eval arg('obstacle_mode') == 'scan')"/>
  </node>
  <node pkg="scout_dwa" type="static_footprint_publisher" name="static_footprint_publisher">
    <rosparam command="load" file="$(arg footprint_config)"/>
    <param name="frame_id" value="$(arg robot_frame)"/>
  </node>

  <include file="$(find dwa_planner)/launch/local_planner.launch">
    <arg name="ns" value="scout_dwa"/>
    <arg name="dwa_param" value="$(arg dwa_config)"/>
    <arg name="robot_param" value="$(arg dwa_config)"/>
    <arg name="global_frame" value="$(arg global_frame)"/>
    <arg name="use_footprint" value="true"/>
    <arg name="use_path_cost" value="false"/>
    <arg name="use_scan_as_input" value="$(eval arg('obstacle_mode') == 'scan')"/>
    <arg name="cmd_vel" value="/scout_dwa/cmd_vel_raw"/>
    <arg name="local_map" value="/scout_dwa/local_map"/>
    <arg name="scan" value="/scout_dwa/scan"/>
    <arg name="odom" value="$(arg odom_topic)"/>
    <arg name="local_goal" value="$(arg goal_topic)"/>
    <arg name="footprint" value="/scout_dwa/footprint"/>
  </include>
  <param name="/scout_dwa/dwa_planner/ROBOT_FRAME" value="$(arg robot_frame)"/>

  <node pkg="scout_dwa" type="cmd_vel_guard" name="cmd_vel_guard" output="screen">
    <rosparam command="load" file="$(arg dwa_config)"/>
    <param name="enabled" value="$(arg enable_motion_output)"/>
    <param name="output_topic" value="$(arg guarded_cmd_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="global_frame" value="$(arg global_frame)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
    <param name="obstacle_mode" value="$(arg obstacle_mode)"/>
    <param name="map_topic" value="/scout_dwa/front_obstacles"/>
    <param name="require_input_health" value="false"/>
    <param name="require_config_health" value="false"/>
    <param name="require_sensor_health" value="true"/>
    <param name="require_localization_health" value="true"/>
    <param name="require_hardware_verification" value="true"/>
    <param name="hardware_verified" value="$(arg hardware_verified)"/>
    <param name="require_footprint" value="true"/>
    <param name="require_rotation_coverage" value="true"/>
    <param name="rotation_coverage_confirmed" value="$(arg rotation_coverage_confirmed)"/>
  </node>
</launch>
