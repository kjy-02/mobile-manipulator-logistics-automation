<?xml version="1.0"?>
<!-- Compatibility entry point for the minimal AMSL DWA integration. Motion output is
     disabled by default and the guarded topic is not the robot /cmd_vel. -->
<launch>
  <arg name="obstacle_mode" default="map" />
  <arg name="pointcloud_topic" default="/velodyne_points" />
  <arg name="odom_topic" default="/scout/odom" />
  <arg name="guarded_cmd_topic" default="/scout_dwa/cmd_vel_safe" />
  <arg name="enable_motion_output" default="false" />
  <arg name="footprint_config" default="$(find scout_dwa)/config/footprint_scout_v2_reference.yaml" />

  <include file="$(find scout_dwa)/launch/scout_dwa.launch">
    <arg name="obstacle_mode" value="$(arg obstacle_mode)" />
    <arg name="pointcloud_topic" value="$(arg pointcloud_topic)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="guarded_cmd_topic" value="$(arg guarded_cmd_topic)" />
    <arg name="enable_motion_output" value="$(arg enable_motion_output)" />
    <arg name="footprint_config" value="$(arg footprint_config)" />
  </include>
</launch>
