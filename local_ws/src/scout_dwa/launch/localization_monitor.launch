<launch>
  <arg name="status_topic" default="/localization/status" />
  <arg name="max_matching_error" doc="Required threshold derived from recorded site data" />
  <arg name="min_inlier_fraction" doc="Required threshold derived from recorded site data" />
  <arg name="required_consecutive" default="3" />
  <arg name="global_frame" default="map" />
  <arg name="odom_frame" default="odom" />
  <arg name="max_correction_translation" doc="Required observed map-to-odom correction jump limit in meters" />
  <arg name="max_correction_rotation" doc="Required observed map-to-odom correction jump limit in radians" />
  <node pkg="scout_dwa" type="localization_monitor.py" name="localization_monitor" output="screen">
    <param name="status_topic" value="$(arg status_topic)" />
    <param name="max_matching_error" value="$(arg max_matching_error)" />
    <param name="min_inlier_fraction" value="$(arg min_inlier_fraction)" />
    <param name="required_consecutive" value="$(arg required_consecutive)" />
    <param name="require_pose_jump_check" value="true" />
    <param name="global_frame" value="$(arg global_frame)" />
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="max_correction_translation" value="$(arg max_correction_translation)" />
    <param name="max_correction_rotation" value="$(arg max_correction_rotation)" />
  </node>
</launch>
