<launch>
  <!-- Short attended commissioning only. Upstream planner stays running.
       Output remains isolated; bounded_drive_test.py is the sole vehicle relay.
       Approval arguments refer to the accepted profile for this trial, not to
       full-range coverage or a firmware watchdog certification. -->
  <arg name="accepted_trial_hardware" default="false" />
  <arg name="accepted_trial_detection" default="false" />
  <arg name="max_matching_error" default="0.05" />
  <arg name="min_inlier_fraction" default="0.90" />
  <arg name="require_rotation_coverage" default="true" />
  <arg name="require_quality_check" default="true" />
  <arg name="require_pose_jump_check" default="true" />
  <arg name="use_swept_footprint" default="false" />
  <arg name="guard_map_topic" default="/scout_dwa/front_obstacles" />
  <arg name="max_angular_z" default="0.20" />
  <arg name="max_linear_x" default="0.30" />
  <node pkg="scout_dwa" type="cloud_obstacle_adapter" name="cloud_obstacle_adapter" output="screen">
    <rosparam command="load" file="$(find scout_dwa)/config/cloud_adapter_reference.yaml" />
    <param name="input_topic" value="/velodyne_points" />
    <param name="target_frame" value="base_link" />
    <param name="publish_map" value="true" />
    <param name="publish_scan" value="false" />
    <param name="coverage_confirmed" value="$(arg accepted_trial_detection)" />
  </node>
  <node pkg="scout_dwa" type="localization_monitor.py" name="localization_monitor" output="screen">
    <!-- Experimental rejection limits, not physical measurements.
         No odom TF exists in the accepted legacy chain; check map->base_link
         pose jumps including normal robot motion, not map->odom correction. -->
    <param name="status_topic" value="/localization/status" />
    <param name="max_matching_error" value="$(arg max_matching_error)" />
    <param name="min_inlier_fraction" value="$(arg min_inlier_fraction)" />
    <param name="required_consecutive" value="3" />
    <param name="require_quality_check" value="$(arg require_quality_check)" />
    <param name="require_pose_jump_check" value="$(arg require_pose_jump_check)" />
    <param name="global_frame" value="map" />
    <param name="odom_frame" value="base_link" />
    <param name="max_correction_translation" value="0.10" />
    <param name="max_correction_rotation" value="0.10" />
  </node>
  <node pkg="scout_dwa" type="cmd_vel_guard" name="cmd_vel_guard" output="screen">
    <rosparam command="load" file="$(find scout_dwa)/config/dwa_scout_low_speed_test.yaml" />
    <param name="enabled" value="false" />
    <param name="output_topic" value="/scout_dwa/cmd_vel_safe" />
    <param name="publish_rate" value="50.0" />
    <param name="odom_topic" value="/scout/odom" />
    <param name="global_frame" value="map" />
    <param name="robot_frame" value="base_link" />
    <param name="map_topic" value="$(arg guard_map_topic)" />
    <param name="use_swept_footprint" value="$(arg use_swept_footprint)" />
    <param name="max_linear_x" value="$(arg max_linear_x)" />
    <param name="max_angular_z" value="$(arg max_angular_z)" />
    <param name="require_input_health" value="false" />
    <param name="require_config_health" value="false" />
    <param name="require_sensor_health" value="true" />
    <param name="require_localization_health" value="true" />
    <param name="require_hardware_verification" value="true" />
    <param name="hardware_verified" value="$(arg accepted_trial_hardware)" />
    <param name="require_footprint" value="true" />
    <param name="require_rotation_coverage" value="$(arg require_rotation_coverage)" />
    <param name="rotation_coverage_confirmed" value="false" />
  </node>
</launch>
