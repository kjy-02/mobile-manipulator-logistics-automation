<?xml version="1.0"?>
<launch>
  <arg name="obstacle_mode" default="map" />
  <arg name="obstacle_x" default="1.0" />
  <arg name="obstacle_y" default="0.5" />
  <arg name="goal_x" default="2.0" />
  <arg name="use_path_cost" default="false" />
  <arg name="publish_synthetic_inputs" default="true" />
  <arg name="use_footprint" default="true" />

  <node if="$(arg publish_synthetic_inputs)" pkg="scout_dwa" type="synthetic_inputs.py" name="synthetic_inputs" output="screen">
    <param name="obstacle_x" value="$(arg obstacle_x)" />
    <param name="obstacle_y" value="$(arg obstacle_y)" />
    <param name="obstacle_z" value="0.2" />
    <param name="goal_x" value="$(arg goal_x)" />
  </node>

  <node pkg="scout_dwa" type="cloud_obstacle_adapter" name="cloud_obstacle_adapter" output="screen">
    <param name="input_topic" value="/scout_dwa/test_points" />
    <param name="target_frame" value="base_link" />
    <param name="coverage_confirmed" value="true" />
    <param name="publish_map" value="$(eval arg('obstacle_mode') == 'map')" />
    <param name="publish_scan" value="$(eval arg('obstacle_mode') == 'scan')" />
    <param name="map_size_x" value="4.0" />
    <param name="map_size_y" value="4.0" />
    <param name="map_resolution" value="0.05" />
    <param name="min_z" value="-0.5" />
    <param name="max_z" value="0.5" />
    <param name="min_range" value="0.05" />
    <param name="max_range" value="3.0" />
    <param name="scan_angle_increment" value="0.017453292519943295" />
  </node>

  <node pkg="scout_dwa" type="static_footprint_publisher" name="static_footprint_publisher">
    <rosparam command="load" file="$(find scout_dwa)/config/synthetic_footprint.yaml" />
  </node>

  <node pkg="dwa_planner" type="dwa_planner" name="dwa_planner" ns="scout_dwa" output="screen">
    <rosparam command="load" file="$(find scout_dwa)/config/synthetic_dwa.yaml" />
    <param name="HZ" value="10.0" />
    <param name="GLOBAL_FRAME" value="map" />
    <param name="SUBSCRIBE_COUNT_TH" value="5" />
    <param name="SLEEP_TIME_AFTER_FINISH" value="0.1" />
    <param name="V_PATH_WIDTH" value="0.02" />
    <param name="USE_FOOTPRINT" value="$(arg use_footprint)" />
    <param name="USE_PATH_COST" value="$(arg use_path_cost)" />
    <param name="USE_SCAN_AS_INPUT" value="$(eval arg('obstacle_mode') == 'scan')" />
    <remap from="/cmd_vel" to="/scout_dwa/cmd_vel_raw" />
    <remap from="/local_map" to="/scout_dwa/local_map" />
    <remap from="/scan" to="/scout_dwa/scan" />
    <remap from="/odom" to="/scout/odom" />
    <remap from="/footprint" to="/scout_dwa/footprint" />
    <remap from="/path" to="/scout_dwa/path_segment" />
  </node>

  <node pkg="scout_dwa" type="cmd_vel_guard" name="cmd_vel_guard" output="screen">
    <param name="enabled" value="true" />
    <param name="obstacle_mode" value="$(arg obstacle_mode)" />
    <param name="max_linear_x" value="0.40" />
    <param name="max_angular_z" value="0.70" />
    <param name="raw_timeout" value="0.5" />
    <param name="odom_timeout" value="0.5" />
    <param name="obstacle_timeout" value="0.5" />
    <param name="health_timeout" value="0.5" />
    <param name="require_input_health" value="true" />
    <param name="require_sensor_health" value="true" />
    <param name="require_localization_health" value="true" />
  </node>
</launch>
