<?xml version="1.0"?>
<launch>
  <arg name="obstacle_mode" default="map" doc="map or scan" />
  <arg name="pointcloud_topic" default="/velodyne_points" />
  <arg name="odom_topic" default="/scout/odom" />
  <arg name="goal_topic" default="/move_base_simple/goal" />
  <arg name="path_topic" default="/scout_dwa/path_segment" />
  <arg name="target_velocity_topic" default="/target_velocity" />
  <arg name="dist_to_goal_topic" default="/dist_to_goal_th" />
  <arg name="global_frame" default="map" />
  <arg name="robot_frame" default="base_link" />
  <arg name="raw_cmd_topic" default="/scout_dwa/cmd_vel_raw" />
  <arg name="guarded_cmd_topic" default="/scout_dwa/cmd_vel_safe" />
  <arg name="enable_motion_output" default="false"
       doc="Keep false until physical parameters and staged tests are complete" />
  <arg name="use_footprint" default="true" />
  <arg name="use_path_cost" default="false" />
  <arg name="dwa_config" default="$(find scout_dwa)/config/dwa_scout_reference.yaml" />
  <arg name="adapter_config" default="$(find scout_dwa)/config/cloud_adapter_reference.yaml" />
  <arg name="footprint_config" default="$(find scout_dwa)/config/footprint_scout_v2_reference.yaml" />
  <node pkg="scout_dwa" type="localization_session.py" name="localization_session" output="screen">
    <param name="global_frame" value="$(arg global_frame)" />
  </node>

  <node pkg="scout_dwa" type="input_gateway.py" name="input_gateway" output="screen">
    <param name="global_frame" value="$(arg global_frame)" />
    <param name="robot_frame" value="$(arg robot_frame)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <rosparam command="load" file="$(arg dwa_config)" />
    <param name="goal_input" value="$(arg goal_topic)" />
    <param name="path_input" value="$(arg path_topic)" />
    <param name="velocity_input" value="$(arg target_velocity_topic)" />
    <param name="distance_input" value="$(arg dist_to_goal_topic)" />
  </node>

  <node pkg="scout_dwa" type="cloud_obstacle_adapter" name="cloud_obstacle_adapter" output="screen">
    <rosparam command="load" file="$(arg adapter_config)" />
    <param name="input_topic" value="$(arg pointcloud_topic)" />
    <param name="target_frame" value="$(arg robot_frame)" />
    <param name="publish_map" value="$(eval arg('obstacle_mode') == 'map')" />
    <param name="publish_scan" value="$(eval arg('obstacle_mode') == 'scan')" />
    <param name="map_topic" value="/scout_dwa/local_map" />
    <param name="scan_topic" value="/scout_dwa/scan" />
  </node>

  <node if="$(arg use_footprint)" pkg="scout_dwa" type="static_footprint_publisher"
        name="static_footprint_publisher" output="screen">
    <rosparam command="load" file="$(arg footprint_config)" />
    <param name="topic" value="/scout_dwa/footprint" />
    <param name="frame_id" value="$(arg robot_frame)" />
  </node>

  <node pkg="scout_dwa" type="planner_preflight.py" name="planner_preflight" ns="scout_dwa" output="screen" required="true">
    <param name="adapter_config_file" value="$(arg adapter_config)" />
    <rosparam command="load" file="$(arg dwa_config)" />
    <param name="HZ" value="20.0" />
    <param name="GLOBAL_FRAME" value="$(arg global_frame)" />
    <param name="ROBOT_FRAME" value="$(arg robot_frame)" />
    <param name="SUBSCRIBE_COUNT_TH" value="3" />
    <param name="SLEEP_TIME_AFTER_FINISH" value="0.5" />
    <param name="V_PATH_WIDTH" value="0.05" />
    <param name="USE_FOOTPRINT" value="$(arg use_footprint)" />
    <param name="USE_PATH_COST" value="$(arg use_path_cost)" />
    <param name="USE_SCAN_AS_INPUT" value="$(eval arg('obstacle_mode') == 'scan')" />
    <remap from="/cmd_vel" to="$(arg raw_cmd_topic)" />
    <remap from="/local_map" to="/scout_dwa/local_map" />
    <remap from="/scan" to="/scout_dwa/scan" />
    <remap from="/move_base_simple/goal" to="/scout_dwa/validated_goal" />
    <remap from="/odom" to="$(arg odom_topic)" />
    <remap from="/footprint" to="/scout_dwa/footprint" />
    <remap from="/path" to="/scout_dwa/validated_path" />
    <remap from="/target_velocity" to="/scout_dwa/validated_target_velocity" />
    <remap from="/dist_to_goal_th" to="/scout_dwa/validated_dist_to_goal" />
  </node>

  <node pkg="scout_dwa" type="cmd_vel_guard" name="cmd_vel_guard" output="screen">
    <rosparam command="load" file="$(arg dwa_config)" />
    <param name="enabled" value="$(arg enable_motion_output)" />
    <param name="raw_cmd_topic" value="$(arg raw_cmd_topic)" />
    <param name="output_topic" value="$(arg guarded_cmd_topic)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="obstacle_mode" value="$(arg obstacle_mode)" />
    <param name="global_frame" value="$(arg global_frame)" />
    <param name="robot_frame" value="$(arg robot_frame)" />
    <param name="map_topic" value="/scout_dwa/local_map" />
    <param name="scan_topic" value="/scout_dwa/scan" />
    <param name="max_linear_x" value="0.50" />
    <param name="max_angular_z" value="0.70" />
    <param name="require_input_health" value="true" />
    <param name="require_sensor_health" value="true" />
    <param name="require_localization_health" value="true" />
    <param name="require_config_health" value="true" />
    <param name="require_hardware_verification" value="true" />
    <param name="hardware_verified" value="false" />
    <param name="require_rotation_coverage" value="true" />
    <param name="require_footprint" value="$(arg use_footprint)" />
    <param name="rotation_coverage_confirmed" value="false" />
  </node>
</launch>
