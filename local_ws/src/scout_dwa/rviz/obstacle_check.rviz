Panels:
- Class: rviz/Displays
  Name: Displays
- Class: rviz/Views
  Name: Views
Visualization Manager:
  Class: ''
  Enabled: true
  Name: root
  Value: true
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 35
    Frame Rate: 30
  Displays:
  - Class: rviz/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
  - Class: rviz/PointCloud2
    Name: Live Raw LiDAR (blue)
    Topic: /velodyne_points
    Enabled: true
    Style: Points
    Size (Pixels): 3
    Decay Time: 0
    Color Transformer: FlatColor
    Color: 50; 180; 255
    Alpha: 1
  - Class: rviz/Map
    Name: DWA Obstacles (occupied black)
    Topic: /scout_dwa/local_map
    Enabled: true
    Alpha: 0.6
    Draw Behind: true
    Color Scheme: map
  - Class: rviz/Polygon
    Name: Robot Footprint
    Topic: /scout_dwa/footprint
    Enabled: true
  - Class: rviz/TF
    Name: Robot Axes (X forward red)
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
  - Class: rviz/PointCloud2
    Name: Hard Room Global Map
    Topic: /globalmap
    Enabled: false
    Style: Points
    Size (Pixels): 2
    Alpha: 0.2
    Color Transformer: FlatColor
    Color: 180; 180; 180
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/SetInitialPose
    Topic: /initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
    Theta std deviation: 0.261799
  - Class: rviz/SetGoal
    Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: base_link
      Scale: 100
      Angle: 0
      X: 0
      Y: 0
